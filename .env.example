# ─── CasePack Self-Host Configuration ────────────────────────────
# Design-partner preview. Install steps: https://docs.casepack.app/self-host-runbook/
# Plain HTTP: run it only on a network you trust until TLS is supported.
# Required fields are marked with (required).
# Enrollment codes are prompted for or read from a protected file; they do not
# belong in .env.

# ── CasePack Version ─────────────────────────────────────────────
CASEPACK_API_VERSION=0.35.1
CASEPACK_SPA_VERSION=0.35.0

# ── Database ─────────────────────────────────────────────────────
DB_NAME=casepack
DB_USER=casepack
DB_PASS=                          # (required) PostgreSQL password
# PostgreSQL isn't published on the host. Use `docker compose exec postgres` for psql or pg_dump.

# ── Keycloak ─────────────────────────────────────────────────────
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASS=                       # (required) Keycloak DB password
KC_ADMIN_USER=admin
KC_ADMIN_PASS=                    # (required) Keycloak admin password
KEYCLOAK_PORT=8081                       # Sign-in (keycloak-edge): only the casepack realm
KEYCLOAK_HOSTNAME=http://localhost:8081  # Set to your auth URL for production
# The admin console listens on this machine only (127.0.0.1). From another
# machine: ssh -L 8082:localhost:8082 <server>, then open KEYCLOAK_ADMIN_URL/admin/.
KEYCLOAK_ADMIN_PORT=8082
KEYCLOAK_ADMIN_URL=http://localhost:8082

# ── Keycloak SMTP (required for multi-user invitations and password resets) ──
# Leave KC_SMTP_HOST empty to start without email. Set KC_SMTP_FROM with it.
KC_SMTP_HOST=
KC_SMTP_PORT=587
KC_SMTP_FROM=
KC_SMTP_FROM_DISPLAY_NAME=CasePack
KC_SMTP_AUTH=true
KC_SMTP_USER=
KC_SMTP_PASSWORD=
KC_SMTP_STARTTLS=true
KC_SMTP_SSL=false

# ── S3 / SeaweedFS ───────────────────────────────────────────────
# (required) Generate both for this install: the bundled SeaweedFS publishes its S3
# port for browser uploads, so a shared default would expose the evidence store.
#   openssl rand -hex 16   (access key)
#   openssl rand -hex 32   (secret key)
# For an external S3 backend, use its credentials and set the endpoints below.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=casepack
S3_REGION=us-east-1
S3_PORT=8333
# Optional. Keep the default internal endpoint for server-only S3 access.
S3_ENDPOINT=http://seaweedfs:8333
# Optional. Browser-facing endpoint used for presigned evidence upload/download URLs.
# Leave blank to sign with S3_ENDPOINT. For local Docker, this hostname routes to the
# host-published SeaweedFS port while the API still uses S3_ENDPOINT internally.
S3_PUBLIC_ENDPOINT=http://casepack-s3.localhost:${S3_PORT}

# ── API ──────────────────────────────────────────────────────────
API_PORT=8080
CORS_ORIGINS=http://localhost:3000
GOTENBERG_URL=http://gotenberg:3000
JAVA_OPTS=-Xms256m -Xmx512m

# ── SPA ──────────────────────────────────────────────────────────
SPA_PORT=3000
API_URL=http://localhost:8080
OIDC_AUTHORITY=http://localhost:8081/realms/casepack

# ── OIDC (auto-wired to bundled Keycloak by default) ─────────────
# Override these if using external Keycloak:
# OIDC_ISSUER_URI=https://auth.example.com/realms/casepack
# OIDC_JWK_SET_URI=https://auth.example.com/realms/casepack/protocol/openid-connect/certs

# ── Connected license and first-run bootstrap ─────────────────────
CASEPACK_DEPLOYMENT_MODE=self_host
# The licensing issuer key this install trusts (Base64URL-encoded public JWK,
# pinned offline: no live JWKS). This is SamSoft's production key k1-prod-initial,
# as served at https://licensing.samuelumeh.com/api/public/jwks. It is a public
# key, not a secret. Change it only to test against another licensing service.
CASEPACK_LICENSE_PUBLIC_KEY=eyJrdHkiOiJPS1AiLCJjcnYiOiJFZDI1NTE5IiwieCI6IldVdU1nbTJOSW5MS01tMHpfYzVfQ25YRV9lcFpqdldJS3otVUFhZ29ZT3MiLCJraWQiOiJrMS1wcm9kLWluaXRpYWwifQ
CASEPACK_SELF_HOST_BOOTSTRAP_ENABLED=true
CASEPACK_SELF_HOST_BOOTSTRAP_TENANT_NAME=CasePack Workspace
# Required: first local CasePack administrator.
CASEPACK_SELF_HOST_BOOTSTRAP_ADMIN_EMAIL=
# Required: one-time password; rotate it after the first successful login.
CASEPACK_SELF_HOST_BOOTSTRAP_ADMIN_INITIAL_PASSWORD=

# ── Keycloak service account (first-admin bootstrap and user invitations) ──
CASEPACK_KEYCLOAK_BASE_URL=http://keycloak:8080
CASEPACK_KEYCLOAK_REALM=casepack
CASEPACK_KEYCLOAK_SPA_CLIENT_ID=casepack-spa
CASEPACK_KEYCLOAK_SPA_REDIRECT_URI=http://localhost:3000/auth/callback
CASEPACK_KEYCLOAK_SA_CLIENT_ID=casepack-user-manager
# (required) Generate it for this install: openssl rand -hex 32. The realm import
# gives the casepack-user-manager client this secret on Keycloak's first start.
CASEPACK_KEYCLOAK_SA_CLIENT_SECRET=

# ── Licensing operations ──────────────────────────────────────────
LICENSING_API_URL=https://licensing.samuelumeh.com
LICENSING_PORTAL_URL=https://licensing.samuelumeh.com/portal

# ── API rate limit ────────────────────────────────────────────────
# Requests per minute per client IP. Behind one office NAT or a reverse proxy
# every user shares an IP, so a self-hosted install allows more than hosted's 300.
CASEPACK_RATE_LIMIT_GLOBAL=1200
